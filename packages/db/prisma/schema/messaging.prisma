/// One row per (event, consumer) pair that has been fully handled.
///
/// Written in the SAME transaction as the consumer's work, so "the work
/// happened" and "we remember it happened" commit or roll back together.
/// Keyed on both columns because one event fans out to several queues:
/// order.rejected is handled once by payments AND once by notifications.
model ProcessedEvent {
  eventId     String   @map("event_id")
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumer])
  @@map("processed_events")
}

/// The transactional outbox.
///
/// Anything that changes an order writes its event here in the same
/// transaction as the change. A relay then publishes unpublished rows to
/// RabbitMQ and stamps `publishedAt`. This closes the gap where the database
/// commits but the publish fails and the event is silently lost.
model OutboxEvent {
  id          String    @id @default(uuid())
  /// The event's own id — consumers deduplicate on this.
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  routingKey  String    @map("routing_key")
  /// The full event envelope, exactly as it will go on the wire.
  payload     Json
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
